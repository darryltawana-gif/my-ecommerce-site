<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seller.name }} - Profile</title>
    <!-- Bootstrap CSS Link -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="card mx-auto shadow-sm" style="max-width: 500px;">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">Seller Profile</h3>
            </div>
            <div class="card-body">
                <p class="card-text"><strong>System Identification ID:</strong> {{ seller.id }}</p>
                <p class="card-text"><strong>Full Name:</strong> {{ seller.name }}</p>
                
                {% if seller.business_name %}
                    <p class="card-text"><strong>Registered Business:</strong> {{ seller.business_name }}</p>
                {% endif %}
                
                <hr>
                <a href="{% url 'home' %}" class="btn btn-outline-secondary btn-sm">← Back to Search</a>
            </div>
        </div>
    </div>

</body>
</html>